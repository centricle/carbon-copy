{
  "manifest_version": 3,
  "name": "Carbon Copy",
  "version": "0.1.0",
  "description": "Keeps a copy of what you submit in job applications and other web forms, as plain files on your own disk.",
  "homepage_url": "https://github.com/centricle/carbon-copy",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "downloads", "offscreen", "scripting", "activeTab"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background/sw.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://boards.eu.greenhouse.io/*",
        "https://job-boards.eu.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://apply.workable.com/*",
        "https://jobs.smartrecruiters.com/*",
        "https://*.icims.com/jobs/*",
        "https://*.bamboohr.com/careers/*"
      ],
      "js": ["src/lib/redact.js", "src/content/capture.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Carbon Copy",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
